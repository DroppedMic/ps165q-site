---
import type { Locale } from '../i18n/ui';
import { home } from '../i18n/home';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const i = home(lang);

/* ----------------------------------------------------------------
   Gallery scenes.

   Each scene has a `svg` (always present, bespoke illustration that
   matches the V13 Apple aesthetic) and an optional `photoUrl`.
   When the school provides real photos, drop the URL into `photoUrl`
   — the IMG will overlay the SVG and `onerror` will fall back to SVG
   if the URL ever 404s.

   Captions are pulled from the per-locale home.ts dictionary so the
   gallery reads in the user's language.
   ---------------------------------------------------------------- */

type Cap = { h: string; m: string };
const caps: Record<Locale, Cap[]> = {
  en: [
    { h: 'STEM Lab', m: 'NEST Program' },
    { h: 'Reading Nook', m: 'Literacy' },
    { h: 'Math Mastery', m: 'Grade 4' },
    { h: 'Spring Concert', m: 'The Arts' },
    { h: 'Recess Joy', m: 'Daily' },
    { h: 'Coding Club', m: 'Digital Learning' },
    { h: 'Art Studio', m: 'Visual Arts' },
    { h: 'Field Day', m: 'Athletics' },
  ],
  zh: [
    { h: 'STEM 实验室', m: 'NEST 项目' },
    { h: '阅读角', m: '语文' },
    { h: '数学课堂', m: '四年级' },
    { h: '春季音乐会', m: '艺术' },
    { h: '课间欢乐', m: '每日' },
    { h: '编程社', m: '数字学习' },
    { h: '美术工作室', m: '视觉艺术' },
    { h: '运动会', m: '体育' },
  ],
  ko: [
    { h: 'STEM 실험실', m: 'NEST 프로그램' },
    { h: '독서 코너', m: '문해 교육' },
    { h: '수학 시간', m: '4학년' },
    { h: '봄 콘서트', m: '예술' },
    { h: '쉬는 시간', m: '매일' },
    { h: '코딩 동아리', m: '디지털 학습' },
    { h: '미술실', m: '시각 예술' },
    { h: '운동회', m: '체육' },
  ],
  es: [
    { h: 'Laboratorio STEM', m: 'Programa NEST' },
    { h: 'Rincón de Lectura', m: 'Alfabetización' },
    { h: 'Maestría en Matemáticas', m: 'Grado 4' },
    { h: 'Concierto de Primavera', m: 'Las Artes' },
    { h: 'Alegría del Recreo', m: 'Diario' },
    { h: 'Club de Programación', m: 'Aprendizaje Digital' },
    { h: 'Estudio de Arte', m: 'Artes Visuales' },
    { h: 'Día de Campo', m: 'Atletismo' },
  ],
};

const c = caps[lang] ?? caps.en;

const scenes: { svg: string; photoUrl?: string; alt?: string }[] = [
  {
    svg: sceneStem(),
    /* photoUrl: 'https://your-cdn/photos/stem.jpg', */
    alt: 'STEM lab — abstract illustration',
  },
  { svg: sceneReading(), alt: 'Reading nook — abstract illustration' },
  { svg: sceneMath(), alt: 'Math class — abstract illustration' },
  { svg: sceneConcert(), alt: 'Spring concert — abstract illustration' },
  { svg: sceneRecess(), alt: 'Recess — abstract illustration' },
  { svg: sceneCoding(), alt: 'Coding club — abstract illustration' },
  { svg: sceneArt(), alt: 'Art studio — abstract illustration' },
  { svg: sceneField(), alt: 'Field day — abstract illustration' },
];

function gradient(id: string, a: string, b: string) {
  return `<defs><linearGradient id="${id}" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="${a}"/><stop offset="1" stop-color="${b}"/></linearGradient></defs><rect width="400" height="480" fill="url(#${id})"/>`;
}
function stars() {
  return `<circle cx="60" cy="60" r="2" fill="#fff" opacity=".5"/><circle cx="340" cy="80" r="1.5" fill="#fff" opacity=".4"/><circle cx="320" cy="400" r="2" fill="#fff" opacity=".5"/>`;
}
function sceneStem() {
  return `<svg class="gal-svg" viewBox="0 0 400 480" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">${gradient('s1', '#0a1628', '#1a3050')}<circle cx="120" cy="200" r="32" fill="#f6c94e"/><circle cx="180" cy="180" r="18" fill="#fde68a"/><rect x="60" y="280" width="300" height="8" rx="3" fill="#fff" opacity=".3"/><rect x="80" y="300" width="260" height="4" rx="2" fill="#fff" opacity=".15"/><polygon points="220,200 200,260 240,260" fill="#a78bfa"/><circle cx="280" cy="220" r="12" fill="#f6c94e"/>${stars()}</svg>`;
}
function sceneReading() {
  return `<svg class="gal-svg" viewBox="0 0 400 480" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">${gradient('s2', '#0071e3', '#0a1628')}<rect x="50" y="240" width="300" height="14" rx="3" fill="#fff" opacity=".2"/><rect x="70" y="260" width="260" height="8" rx="3" fill="#fff" opacity=".12"/><rect x="60" y="160" width="80" height="80" rx="6" fill="#f6c94e"/><rect x="150" y="160" width="70" height="80" rx="6" fill="#fde68a"/><rect x="230" y="160" width="80" height="80" rx="6" fill="#fff" opacity=".6"/>${stars()}</svg>`;
}
function sceneMath() {
  return `<svg class="gal-svg" viewBox="0 0 400 480" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">${gradient('s3', '#16a34a', '#0a1628')}<text x="200" y="220" font-size="92" font-family="Inter Tight,sans-serif" font-weight="700" fill="#f6c94e" text-anchor="middle" dominant-baseline="middle">∑</text><circle cx="120" cy="160" r="16" fill="#fff" opacity=".7"/><circle cx="280" cy="170" r="10" fill="#fff" opacity=".5"/><polygon points="150,290 130,320 170,320" fill="#fff" opacity=".3"/><rect x="220" y="300" width="80" height="30" rx="3" fill="#fff" opacity=".2"/>${stars()}</svg>`;
}
function sceneConcert() {
  return `<svg class="gal-svg" viewBox="0 0 400 480" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">${gradient('s4', '#7c3aed', '#0a1628')}<circle cx="200" cy="270" r="90" fill="#f6c94e" opacity=".15"/><polygon points="180,160 160,300 200,300" fill="#f6c94e"/><polygon points="220,160 200,300 240,300" fill="#fde68a"/><circle cx="200" cy="200" r="18" fill="#fff"/><rect x="60" y="380" width="280" height="6" rx="3" fill="#fff" opacity=".4"/>${stars()}</svg>`;
}
function sceneRecess() {
  return `<svg class="gal-svg" viewBox="0 0 400 480" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">${gradient('s5', '#f6c94e', '#d4a52a')}<circle cx="120" cy="220" r="32" fill="#0a1628"/><circle cx="280" cy="210" r="30" fill="#fff" opacity=".7"/><rect x="50" y="340" width="300" height="10" rx="4" fill="#0a1628" opacity=".3"/><polygon points="200,120 185,180 215,180" fill="#0a1628"/></svg>`;
}
function sceneCoding() {
  return `<svg class="gal-svg" viewBox="0 0 400 480" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">${gradient('s6', '#0a1628', '#16a34a')}<text x="100" y="220" font-size="56" font-family="Inter Tight,sans-serif" font-weight="700" fill="#22c55e" text-anchor="middle" dominant-baseline="middle">&lt;/&gt;</text><text x="280" y="220" font-size="52" font-family="Inter Tight,sans-serif" font-weight="700" fill="#f6c94e" text-anchor="middle" dominant-baseline="middle">{ }</text><rect x="40" y="300" width="320" height="4" rx="2" fill="#fff" opacity=".2"/><rect x="40" y="320" width="200" height="4" rx="2" fill="#fff" opacity=".15"/>${stars()}</svg>`;
}
function sceneArt() {
  return `<svg class="gal-svg" viewBox="0 0 400 480" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">${gradient('s7', '#e74c3c', '#7c3aed')}<circle cx="100" cy="220" r="42" fill="#f6c94e"/><circle cx="180" cy="200" r="32" fill="#fff" opacity=".8"/><circle cx="260" cy="240" r="38" fill="#22c55e"/><rect x="50" y="350" width="300" height="8" rx="3" fill="#fff" opacity=".3"/>${stars()}</svg>`;
}
function sceneField() {
  return `<svg class="gal-svg" viewBox="0 0 400 480" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">${gradient('s8', '#22c55e', '#16a34a')}<circle cx="150" cy="240" r="14" fill="#fff"/><circle cx="180" cy="240" r="14" fill="#f6c94e"/><circle cx="210" cy="240" r="14" fill="#fff"/><circle cx="240" cy="240" r="14" fill="#f6c94e"/><polygon points="110,240 90,260 130,260" fill="#fff" opacity=".7"/><polygon points="280,240 260,260 300,260" fill="#fff" opacity=".7"/>${stars()}</svg>`;
}
---

<section class="gtile">
  <div class="gtile-head">
    <div>
      <div class="tile-eyebrow">{i.gallery.eyebrow}</div>
      <h2 class="gtile-h">{i.gallery.title1}<br /><span class="lt">{i.gallery.title2}</span></h2>
    </div>
  </div>
  <div class="gal-rail" id="gal-rail">
    {scenes.map((s, idx) => (
      <div class="gal-card">
        {s.photoUrl && (
          <img
            class="gal-img"
            src={s.photoUrl}
            alt={c[idx]?.h ?? ''}
            loading="lazy"
            decoding="async"
            onerror="this.style.display='none'"
          />
        )}
        <Fragment set:html={s.svg} />
        <div class="gal-info">
          <div class="gal-eyebrow">{c[idx]?.m}</div>
          <div class="gal-h">{c[idx]?.h}</div>
        </div>
      </div>
    ))}
  </div>
</section>
