---
import { getCollection } from 'astro:content';
import type { Locale } from '../i18n/ui';
import { pages } from '../i18n/pages';
import { dateLocaleFor } from '../i18n/home';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const p = pages(lang);
const dateLocale = dateLocaleFor(lang);

const posts = (await getCollection('news', ({ data }) => !data.draft))
  .sort((a, b) => +b.data.date - +a.data.date);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const langPrefix = lang === 'en' ? '' : `/${lang}`;
---

<section class="page-hero">
  <div class="wrap">
    <div class="tile-eyebrow">{p.news.listEyebrow}</div>
    <h1>{p.news.listTitle1}<br /><span style="color:var(--ink-3)">{p.news.listTitle2}</span></h1>
    <p>{p.news.listLead}</p>
  </div>
</section>

{posts.length === 0 ? (
  <section class="psec">
    <div class="wrap" style="text-align:center;color:var(--ink-3)">{p.news.empty}</div>
  </section>
) : (
  <section class="psec" style="padding-top:clamp(40px,5vw,60px)">
    <div class="news-grid">
      {posts.map((post) => (
        <a href={`${base}${langPrefix}/news/${post.id.replace(/\.md$/, '')}/`} class="news-card">
          <div class="news-date">
            {post.data.date.toLocaleDateString(dateLocale, { month: 'short', day: 'numeric', year: 'numeric' })}
          </div>
          <h2 class="news-card-h">{post.data.title}</h2>
          <p class="news-card-s">{post.data.summary}</p>
          <span class="news-card-foot">{p.news.readMore}</span>
        </a>
      ))}
    </div>
  </section>
)}
