---
import { render, type CollectionEntry } from 'astro:content';
import type { Locale } from '../i18n/ui';
import { pages } from '../i18n/pages';

interface Props {
  lang: Locale;
  program: CollectionEntry<'programs'>;
}

const { lang, program } = Astro.props;
const p = pages(lang);
const { Content } = await render(program);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const langPrefix = lang === 'en' ? '' : `/${lang}`;
---

<section class="page-hero">
  <div class="wrap">
    <a href={`${base}${langPrefix}/#programs`} class="back-link">{p.programs.back}</a>
    <div class="tile-eyebrow" style="color:var(--gold-2)">{program.data.tag}</div>
    <h1>{program.data.title}</h1>
    <p>{program.data.summary}</p>
    {program.data.learnMoreUrl && (
      <div style="margin-top:24px;display:flex;gap:18px;justify-content:center;flex-wrap:wrap">
        <a href={program.data.learnMoreUrl} target="_blank" rel="noopener" class="btn btn-pill">
          {p.programs.learnMoreOfficial}
        </a>
        <a href={`${base}${langPrefix}/#apply`} class="lnk">{p.programs.apply}</a>
      </div>
    )}
  </div>
</section>

{program.data.stats && program.data.stats.length > 0 && (
  <section class="psec" style="padding-top:0">
    <div class="wrap" style="max-width:920px">
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px">
        {program.data.stats.map((s) => (
          <div style="background:var(--tile-mid);border-radius:18px;padding:28px;text-align:center">
            <div style="font-family:'Inter Tight',sans-serif;font-size:32px;font-weight:700;letter-spacing:-.025em;color:var(--ink);line-height:1.1">
              {s.value}
            </div>
            <div style="font-size:13px;color:var(--ink-3);margin-top:6px;letter-spacing:-.005em">
              {s.label}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<article class="article" style="padding-top:clamp(36px,5vw,60px)">
  <div class="prose">
    <Content />
  </div>
</article>

<section class="psec" style="padding-top:0">
  <div class="wrap" style="max-width:760px;text-align:center">
    <h2
      style="font-family:'Inter Tight',sans-serif;font-size:clamp(28px,4vw,40px);font-weight:600;letter-spacing:-.035em;line-height:1.1;margin-bottom:14px"
    >{p.programs.footerH}</h2>
    <p style="color:var(--ink-3);max-width:540px;margin:0 auto 28px;line-height:1.4">
      {p.programs.footerLead}
    </p>
    <div style="display:flex;gap:18px;justify-content:center;flex-wrap:wrap">
      <a href={`${base}${langPrefix}/#contact`} class="lnk">{p.programs.tour}</a>
      <a href="https://www.schools.nyc.gov/enrollment/enroll-grade-by-grade" target="_blank" rel="noopener" class="btn btn-pill">
        {p.programs.cta}
      </a>
    </div>
  </div>
</section>
