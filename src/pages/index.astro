---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const programs = (await getCollection('programs'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);

const upcomingEvents = (await getCollection('events'))
  .sort((a, b) => +a.data.date - +b.data.date)
  .slice(0, 6);

const news = (await getCollection('news', ({ data }) => !data.draft))
  .sort((a, b) => +b.data.date - +a.data.date)
  .slice(0, 3);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const monthFmt = (d: Date) => d.toLocaleString('en-US', { month: 'short' });
---

<BaseLayout
  title="P.S. 165Q — Edith K. Bergtraum School"
  description="Every child, a Shooting Star. Pre-K through Grade 5 in Flushing, Queens."
>
  <!-- Announcement strip -->
  <div class="strip">
    Now enrolling for 2026–27. <a href="#apply">Apply on MySchools ›</a>
  </div>

  <div class="stack">
    <!-- HERO -->
    <section class="tile hero white" id="hero">
      <div class="tile-eyebrow">P.S. 165Q · Edith K. Bergtraum School</div>
      <h1 class="tile-h">Every child,<br />a Shooting&nbsp;Star.</h1>
      <p class="tile-sub">
        An elementary school where curiosity becomes capability.<br />
        Pre-K through Grade 5 in Flushing, Queens — since 1960.
      </p>
      <div class="tile-cta">
        <a href="#programs" class="lnk">Learn more</a>
        <a href="#apply" class="btn btn-pill">Apply for 2026–27</a>
      </div>
      <div class="tile-visual">
        <div class="hero-mark">165</div>
      </div>
    </section>

    <!-- G&T -->
    <section class="tile dark" id="programs">
      <div class="tile-eyebrow">Gifted &amp; Talented</div>
      <h2 class="tile-h">Where curious minds<br />are stretched.</h2>
      <p class="tile-sub">
        An accelerated curriculum for students identified through NYC DOE
        admissions. Advanced problem-solving, independent research, and depth
        in every core subject.
      </p>
      <div class="tile-cta">
        <a
          href="https://www.schools.nyc.gov/enrollment/enroll-grade-by-grade/gifted-and-talented"
          target="_blank"
          rel="noopener"
          class="lnk"
          style="color:#fff"
        >Learn more</a>
        <a href="#apply" class="btn btn-pill-light">Apply</a>
      </div>
    </section>

    <!-- NEST + Arts -->
    <div class="tile-row">
      <section class="tile white">
        <div class="tile-eyebrow">NEST</div>
        <h2 class="tile-h">Project-based<br />STEM and arts.</h2>
        <p class="tile-sub">Hands-on builds with integrated technology. Work that travels home.</p>
        <div class="tile-cta">
          <a href={`${base}/news/`} class="lnk">See it in action</a>
          <a href="#programs" class="btn btn-pill">Explore</a>
        </div>
      </section>
      <section class="tile gold">
        <div class="tile-eyebrow">The Arts</div>
        <h2 class="tile-h">Music, theater,<br />visual art.</h2>
        <p class="tile-sub">
          From the Spring Concert to weekly studio time — creative work that stays with them.
        </p>
        <div class="tile-cta">
          <a href={`${base}/news/`} class="lnk">Recent highlights</a>
          <a href="#programs" class="btn btn-pill-dark">See the Arts</a>
        </div>
      </section>
    </div>

    <!-- APPLY CTA -->
    <section class="tile gold short" id="apply">
      <div class="tile-eyebrow">Now Enrolling</div>
      <h2 class="tile-h">Apply for 2026–27.<br /><span class="lt">Make this their year.</span></h2>
      <p class="tile-sub">
        Pre-K, Kindergarten, and grade transfers open through the NYC DOE
        MySchools portal.
      </p>
      <div class="tile-cta">
        <a href="#contact" class="lnk">Schedule a tour</a>
        <a
          href="https://www.schools.nyc.gov/enrollment/enroll-grade-by-grade"
          target="_blank"
          rel="noopener"
          class="btn btn-pill-dark"
        >Apply on MySchools</a>
      </div>
    </section>
  </div>

  <!-- ALL PROGRAMS (from content collection) -->
  <section class="psec">
    <div class="psec-head">
      <span class="psec-eyebrow">Academics</span>
      <h2 class="psec-h">Programs<br /><span class="lt">that shape the way they think.</span></h2>
      <p class="psec-lead">
        From accelerated G&amp;T to social-emotional learning, every program
        is built around how children actually grow.
      </p>
    </div>
    <div class="prog-grid">
      {programs.map((p) => (
        <a href={`${base}/programs/${p.id}/`} class="prog">
          <span class="prog-tag">{p.data.tag}</span>
          <h3 class="prog-h">{p.data.title}</h3>
          <p class="prog-d">{p.data.summary}</p>
          <span class="prog-arr">Learn more ›</span>
        </a>
      ))}
    </div>
  </section>

  <!-- LATEST NEWS -->
  {news.length > 0 && (
    <section class="psec" style="padding-top:0">
      <div class="psec-head">
        <span class="psec-eyebrow">From the school</span>
        <h2 class="psec-h">Latest news.</h2>
      </div>
      <div class="news-grid">
        {news.map((n) => (
          <a href={`${base}/news/${n.id.replace(/\.md$/, '')}/`} class="news-card">
            <div class="news-date">
              {n.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
            </div>
            <h3 class="news-card-h">{n.data.title}</h3>
            <p class="news-card-s">{n.data.summary}</p>
            <span class="news-card-foot">Read story ›</span>
          </a>
        ))}
      </div>
      <div style="text-align:center;margin-top:36px">
        <a href={`${base}/news/`} class="lnk">All news</a>
      </div>
    </section>
  )}

  <!-- CALENDAR (from content collection) -->
  <section class="psec" id="calendar" style="padding-top:0">
    <div class="psec-head">
      <span class="psec-eyebrow">Upcoming</span>
      <h2 class="psec-h">School calendar.</h2>
    </div>
    <div class="cal">
      {upcomingEvents.map((ev) => (
        <a href={`${base}/#calendar`} class="cal-item">
          <div class="cal-date">
            <div class="cal-mo">{monthFmt(ev.data.date)}</div>
            <div class="cal-dy">{ev.data.date.getDate()}</div>
          </div>
          <div>
            <div class="cal-t">{ev.data.title}</div>
            {ev.data.time && <div class="cal-tm">{ev.data.time}</div>}
          </div>
          {ev.data.badge !== 'none' && (
            <span class={`cal-tag ${ev.data.badge}`}>{ev.data.badge}</span>
          )}
        </a>
      ))}
    </div>
  </section>

  <!-- CONTACT -->
  <section class="psec" id="contact" style="padding-top:0">
    <div class="psec-head">
      <span class="psec-eyebrow">Contact</span>
      <h2 class="psec-h">Get in touch.</h2>
      <p class="psec-lead">
        70-35 150 Street, Flushing, NY 11367 · <a href="tel:7182634004">(718) 263-4004</a>
        · Mon–Fri 8:00 AM – 2:20 PM
      </p>
    </div>
  </section>
</BaseLayout>
